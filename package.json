{
  "name": "appium-side-project",
  "version": "1.0.0",
  "private": true,
  "description": "Android mobile UI automation demo: Appium 3 + WebdriverIO 9 + TypeScript, running against the ApiDemos sample app on an Android emulator.",
  "type": "module",
  "scripts": {
    "test": "wdio run ./wdio.conf.ts",
    "test:smoke": "wdio run ./wdio.conf.ts --suite smoke",
    "typecheck": "tsc --noEmit",
    "emulator": "./scripts/start-emulator.sh",
    "appium": "appium --allow-cors",
    "appium:drivers": "appium driver list --installed"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "appium": "^3.7.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "webdriverio": "^9.32.0"
  }
}
